---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

import myPic from "../../assets/MY-Picture.jpg";
import pizza from "../../assets/portfolio/pizza.png";
import cvPng from "../../assets/portfolio/cv.png";
import dashPng from "../../assets/portfolio/dashboard.png";
import financePng from "../../assets/portfolio/finance-tracker.png";

import codeSvg from "../../assets/avatars/code-xml.svg";
import bugSvg from "../../assets/avatars/bug-off.svg";
import gaugeSvg from "../../assets/avatars/gauge.svg";
import sparkleSvg from "../../assets/avatars/sparkle.svg";

import cvPdf from "../../assets/omar-elbakri-cv.pdf";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
---

<BaseLayout title="Omar">
	<!-- # preloader -->
	<div id="preloader">
		<div id="loader"></div>
	</div>

	<!-- # page wrap -->
	<div class="s-pagewrap">
		<div class="circles">
			<span></span><span></span><span></span><span></span><span></span>
		</div>

		<!-- ## header -->
		<header class="s-header">
			<div class="header-mobile">
				<span class="mobile-home-link"><a href="/">Omar.</a></span>
				<div class="header-controls">
					<LanguageSwitcher
						variant="icon"
						className="lang-switcher-mobile"
					/>
					<a class="mobile-menu-toggle" href="#0"><span>Menu</span></a
					>
				</div>
			</div>

			<div class="row wide main-nav-wrap">
				<nav class="column lg-12 main-nav">
					<ul>
						<li><a href="/" class="home-link">Omar.</a></li>
						<li class="current">
							<a href="#intro" class="smoothscroll">Intro</a>
						</li>
						<li>
							<a href="#about" class="smoothscroll">À propos</a>
						</li>
						<li>
							<a href="#works" class="smoothscroll">Projets</a>
						</li>
						<li>
							<a href="#contact" class="smoothscroll"
								>Dire bonjour</a
							>
						</li>
						<li class="lang-switcher-desktop">
							<LanguageSwitcher />
						</li>

						<script is:inline>
							// Navigate when the user picks a language
							document
								.getElementById("langSwitch")
								?.addEventListener("change", (e) => {
									const url = e.target.value;
									if (url) location.assign(url);
								});
						</script>
					</ul>
				</nav>
			</div>
		</header>

		<!-- ## main -->
		<main class="s-content">
			<!-- ### intro -->
			<section id="intro" class="s-intro target-section">
				<div class="row intro-content wide">
					<div class="column">
						<div class="text-pretitle with-line">
							Bienvenue&nbsp;!
						</div>
						<h1 class="text-huge-title">
							Je suis Omar, <br /> développeur full-stack, <br /> je
							construis des choses <br /> à Osnabrück, en Allemagne.
						</h1>
					</div>

					<ul class="intro-social">
						<li>
							<a
								href="https://www.linkedin.com/in/omar-elbakri-345171349/"
								target="_blank">LinkedIn</a
							>
						</li>
						<li>
							<a
								href="https://github.com/omgawroo98"
								target="_blank">GitHub</a
							>
						</li>
						<li>
							<a
								href="https://www.youtube.com/channel/UCXQ-JiemL1d4UkBP_PS7ZKA"
								target="_blank">YouTube</a
							>
						</li>
						<li>
							<a
								href="mailto:omar.elbakri00@gmail.com"
								target="_blank">Email</a
							>
						</li>
					</ul>
				</div>

				<a
					href="#about"
					class="intro-scrolldown smoothscroll"
					aria-label="faire défiler"
				>
					<svg
						width="24"
						height="24"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						fill-rule="evenodd"
						clip-rule="evenodd"
					>
						<path
							d="M11 21.883l-6.235-7.527-.765.644 7.521 9 7.479-9-.764-.645-6.236 7.529v-21.884h-1v21.883z"
						></path>
					</svg>
				</a>
			</section>

			<!-- ### about -->
			<section id="about" class="s-about target-section">
				<div class="row about-info wide" data-animate-block>
					<div class="column lg-6 md-12 about-info__pic-block">
						<Image
							src={myPic}
							alt=""
							class="about-info__pic"
							loading="lazy"
							decoding="async"
							sizes="(min-width: 1024px) 50vw, 100vw"
							widths={[480, 720, 960, 1200]}
						/>
					</div>

					<div class="column lg-6 md-12">
						<div class="about-info__text">
							<h2 class="text-pretitle with-line" data-animate-el>
								C’est moi 👋🏻
							</h2>
							<p class="attention-getter" data-animate-el>
								Je suis développeur full-stack basé en
								Allemagne, passionné par la création
								d’applications web évolutives et performantes.
								J’aime les projets exigeants qui repoussent mes
								limites et me permettent d’explorer des
								technologies de pointe.
							</p>
							<a
								href={cvPdf}
								target="_blank"
								class="btn btn--medium u-fullwidth"
								data-animate-el
								download>Télécharger le CV</a
							>
						</div>
					</div>
				</div>

				<div class="row about-expertise" data-animate-block>
					<div class="column lg-12">
						<h2 class="text-pretitle" data-animate-el>
							Compétences
						</h2>
						<ul class="skills-list h1" data-animate-el>
							Je conçois et développe des applications web
							évolutives et centrées utilisateur, du front au
							back.
						</ul>
					</div>
				</div>

				<div class="row about-timelines" data-animate-block>
					<div class="column lg-6 tab-12">
						<h2 class="text-pretitle" data-animate-el>
							Expérience
						</h2>

						<div class="timeline" data-animate-el>
							<div class="timeline__block">
								<div class="timeline__bullet"></div>
								<div class="timeline__header">
									<h4 class="timeline__title">
										Développeur logiciel full-stack
									</h4>
									<h5 class="timeline__meta">
										123erfasst GmbH, Lohne
									</h5>
									<p class="timeline__timeframe">
										Août 2023 – Aujourd’hui
									</p>
								</div>
								<div class="timeline__desc">
									<p>
										Développement d’applications web
										évolutives avec React, Tailwind CSS et
										.NET (C#). Construction de composants
										UI, intégration de GraphQL et gestion
										des pipelines CI/CD avec GitHub Actions.
										Orchestration Kubernetes et
										collaboration agile en équipe Scrum.
									</p>
								</div>
							</div>

							<div class="timeline__block">
								<div class="timeline__bullet"></div>
								<div class="timeline__header">
									<h4 class="timeline__title">
										Stage – Support technique
									</h4>
									<h5 class="timeline__meta">
										LWLCOM, Brême
									</h5>
									<p class="timeline__timeframe">
										Octobre 2021 – Novembre 2021
									</p>
								</div>
								<div class="timeline__desc">
									<p>
										Support technique pour des composants
										réseau (routeurs, fibre optique,
										switches) et aperçu des opérations de
										centre de données et de l’infrastructure
										IT.
									</p>
								</div>
							</div>
						</div>
						<!-- end timeline -->
					</div>
					<!-- end column -->

					<div class="column lg-6 tab-12">
						<h2 class="text-pretitle" data-animate-el>Formation</h2>

						<div class="timeline" data-animate-el>
							<div class="timeline__block">
								<div class="timeline__bullet"></div>
								<div class="timeline__header">
									<h4 class="timeline__title">
										B.Sc. Informatique de gestion
										(alternance)
									</h4>
									<h5 class="timeline__meta">
										Université des sciences appliquées
										d’Osnabrück
									</h5>
									<p class="timeline__timeframe">
										Août 2023 – prévu pour juillet 2026
									</p>
								</div>
								<div class="timeline__desc">
									<p>
										Accent sur le développement web, les
										méthodologies agiles, les bases de
										données et la gestion de projet IT dans
										un cursus coopératif avec phases
										pratiques.
									</p>
								</div>
							</div>

							<div class="timeline__block">
								<div class="timeline__bullet"></div>
								<div class="timeline__header">
									<h4 class="timeline__title">
										Spécialiste IT – Développement
										d’applications
									</h4>
									<h5 class="timeline__meta">
										IHK Osnabrück
									</h5>
									<p class="timeline__timeframe">
										Août 2023 – Juin 2025
									</p>
								</div>
								<div class="timeline__desc">
									<p>
										Formation intégrée à la pratique axée
										sur le développement logiciel, le
										networking et la conception de bases de
										données.
									</p>
								</div>
							</div>

							<div class="timeline__block">
								<div class="timeline__bullet"></div>
								<div class="timeline__header">
									<h4 class="timeline__title">
										Assistant en technologies de
										l’information
									</h4>
									<h5 class="timeline__meta">
										Schulzentrum Utbremen
									</h5>
									<p class="timeline__timeframe">
										Juillet 2020 – Juillet 2022
									</p>
								</div>
								<div class="timeline__desc">
									<p>
										Formation scolaire mettant l’accent sur
										la programmation, l’ingénierie réseau et
										les fondamentaux techniques.
									</p>
								</div>
							</div>
						</div>
						<!-- end timeline -->
					</div>
					<!-- end column -->
				</div>
			</section>

			<!-- ### works -->
			<section id="works" class="s-works target-section">
				<div class="row works-portfolio">
					<div class="column lg-12" data-animate-block>
						<h2 class="text-pretitle" data-animate-el>
							Mon travail 🛠️
						</h2>
						<p class="h1" data-animate-el>
							Voici ce sur quoi j'ai travaillé jusqu'à présent et
							ce que je prévois de faire !
						</p>

						<ul
							class="folio-list row block-lg-one-half block-stack-on-1000"
						>
							<li class="folio-list__item column" data-animate-el>
								<a
									class="folio-list__item-link"
									href="#modal-01"
								>
									<div class="folio-list__item-pic">
										<Image
											src={pizza}
											alt=""
											loading="lazy"
											decoding="async"
											sizes="(min-width: 1000px) 50vw, 100vw"
											widths={[360, 600, 900, 1200]}
										/>
									</div>
									<div class="folio-list__item-text">
										<div class="folio-list__item-cat">
											Application full-stack
										</div>
										<div class="folio-list__item-title">
											Simulateur de bandit manchot à
											pizzas
										</div>
									</div>
								</a>
							</li>

							<li class="folio-list__item column" data-animate-el>
								<a
									class="folio-list__item-link"
									href="#modal-02"
								>
									<div class="folio-list__item-pic">
										<Image
											src={cvPng}
											alt=""
											loading="lazy"
											decoding="async"
											sizes="(min-width: 1000px) 50vw, 100vw"
											widths={[360, 600, 900, 1200]}
										/>
									</div>
									<div class="folio-list__item-text">
										<div class="folio-list__item-cat">
											IA / Back-end
										</div>
										<div class="folio-list__item-title">
											Analyseur de CV par IA (bientôt)
										</div>
									</div>
								</a>
							</li>

							<li class="folio-list__item column" data-animate-el>
								<a
									class="folio-list__item-link"
									href="#modal-03"
								>
									<div class="folio-list__item-pic">
										<Image
											src={dashPng}
											alt=""
											loading="lazy"
											decoding="async"
											sizes="(min-width: 1000px) 50vw, 100vw"
											widths={[360, 600, 900, 1200]}
										/>
									</div>
									<div class="folio-list__item-text">
										<div class="folio-list__item-cat">
											UI / Composants
										</div>
										<div class="folio-list__item-title">
											Panneau d’administration React
											(bientôt)
										</div>
									</div>
								</a>
							</li>

							<li class="folio-list__item column" data-animate-el>
								<a
									class="folio-list__item-link"
									href="#modal-04"
								>
									<div class="folio-list__item-pic">
										<Image
											src={financePng}
											alt=""
											loading="lazy"
											decoding="async"
											sizes="(min-width: 1000px) 50vw, 100vw"
											widths={[360, 600, 900, 1200]}
										/>
									</div>
									<div class="folio-list__item-text">
										<div class="folio-list__item-cat">
											Tableau de bord
										</div>
										<div class="folio-list__item-title">
											Suivi des finances (bientôt)
										</div>
									</div>
								</a>
							</li>
						</ul>
					</div>

					<!-- Modals (use same imported images) -->
					<div id="modal-01" hidden>
						<div class="modal-popup">
							<Image
								src={pizza}
								alt=""
								widths={[640, 960, 1280]}
								sizes="100vw"
							/>
							<div class="modal-popup__desc">
								<h5>Simulateur de bandit manchot à pizzas</h5>
								<p>
									Un simulateur complet qui visualise les
									algorithmes de bandit manchot à plusieurs
									bras à travers une expérience interactive de
									garniture de pizza. Les utilisateurs peuvent
									configurer les types de bandits, télécharger
									des algorithmes personnalisés et comparer
									les performances en temps réel.
								</p>
								<ul class="modal-popup__cat">
									<li>full-stack</li>
								</ul>

								<a
									href="https://github.com/kevinkeller021204/bandit"
									target="_blank"
									class="modal-popup__details"
									>Lien du projet</a
								>
							</div>
						</div>
					</div>

					<div id="modal-02" hidden>
						<div class="modal-popup">
							<Image
								src={cvPng}
								alt=""
								widths={[640, 960, 1280]}
								sizes="100vw"
							/>
							<div class="modal-popup__desc">
								<h5>Analyseur de CV par IA (bientôt)</h5>
								<p>
									Téléversez un CV et obtenez des informations
									structurées grâce au NLP - extraction
									automatique des compétences, des rôles et de
									la formation.
								</p>
								<ul class="modal-popup__cat">
									<li>IA</li>
									<li>Back-end</li>
								</ul>
							</div>
						</div>
					</div>

					<div id="modal-03" hidden>
						<div class="modal-popup">
							<Image
								src={dashPng}
								alt=""
								widths={[640, 960, 1280]}
								sizes="100vw"
							/>
							<div class="modal-popup__desc">
								<h5>React Admin Dashboard (bientôt)</h5>
								<p>
									Un tableau de bord d’administration élégant
									et modulaire, construit avec React pour
									gérer utilisateurs, contenu et analyses via
									des composants réutilisables.
								</p>
								<ul class="modal-popup__cat">
									<li>UI</li>
									<li>Composants</li>
								</ul>
							</div>
						</div>
					</div>

					<div id="modal-04" hidden>
						<div class="modal-popup">
							<Image
								src={financePng}
								alt=""
								widths={[640, 960, 1280]}
								sizes="100vw"
							/>
							<div class="modal-popup__desc">
								<h5>Suivi des finances (bientôt)</h5>
								<p>
									Un tableau de bord pour suivre les dépenses,
									catégoriser les transactions et visualiser
									les finances personnelles en temps réel.
								</p>
								<ul class="modal-popup__cat">
									<li>Tableau de bord</li>
									<li>Analyse</li>
								</ul>
							</div>
						</div>
					</div>
				</div>

				<div class="row testimonials">
					<div class="column lg-12" data-animate-block>
						<h2 class="text-pretitle" data-animate-el>
							Mes valeurs
						</h2>
						<p class="h1" data-animate-el>
							Voici, en un coup d’œil, ce qui compte pour
							moi&nbsp;!
						</p>

						<div
							class="swiper-container testimonial-slider"
							data-animate-el
						>
							<div class="swiper-wrapper">
								<div
									class="testimonial-slider__slide swiper-slide"
								>
									<div class="testimonial-slider__author">
										<img
											src={codeSvg.src}
											alt="Author image"
											class="testimonial-slider__avatar"
										/>
										<cite class="testimonial-slider__cite">
											<strong>Code propre</strong>
											<span
												>Lisible par des humains, pas
												seulement par des machines</span
											>
										</cite>
									</div>
									<p>
										Je crois qu’un bon code est simple,
										auto-explicatif et facile à itérer.
										Écrire avec intention et structure
										permet aux équipes d’avancer plus vite
										et de rester alignées, même à l’échelle.
									</p>
								</div>
								<!-- end testimonial-slider__slide -->

								<div
									class="testimonial-slider__slide swiper-slide"
								>
									<div class="testimonial-slider__author">
										<img
											src={bugSvg.src}
											alt="Author image"
											class="testimonial-slider__avatar"
										/>
										<cite class="testimonial-slider__cite">
											<strong>Les tests comptent</strong>
											<span
												>Parce que les bugs ne se
												présentent pas d’eux-mêmes</span
											>
										</cite>
									</div>
									<p>
										Je ne traite pas les tests comme un
										luxe. C’est un filet de sécurité qui me
										donne la confiance pour livrer vite et
										bien. J’utilise les tests pour valider
										les hypothèses, capturer les régressions
										et soutenir la stabilité à long terme.
									</p>
								</div>
								<!-- end testimonial-slider__slide -->

								<div
									class="testimonial-slider__slide swiper-slide"
								>
									<div class="testimonial-slider__author">
										<img
											src={gaugeSvg.src}
											alt="Author image"
											class="testimonial-slider__avatar"
										/>
										<cite class="testimonial-slider__cite">
											<strong>Performance</strong>
											<span
												>La vitesse est une
												fonctionnalité</span
											>
										</cite>
									</div>
									<p>
										Les utilisateurs remarquent la latence.
										Je me concentre sur des applications
										performantes et réactives, agréables et
										fluides, même sur des appareils peu
										puissants. Si c’est lent, c’est cassé —
										et je le corrige.
									</p>
								</div>
								<!-- end testimonial-slider__slide -->

								<div
									class="testimonial-slider__slide swiper-slide"
								>
									<div class="testimonial-slider__author">
										<img
											src={sparkleSvg.src}
											alt="Author image"
											class="testimonial-slider__avatar"
										/>
										<cite class="testimonial-slider__cite">
											<strong>Sens du détail</strong>
											<span
												>Les petites choses font une
												grande différence</span
											>
										</cite>
									</div>
									<p>
										Le design est dans les détails. Des
										maquettes pixel-perfect à
										l’accessibilité clavier et au balisage
										semantique, je me soucie de toute
										l’expérience utilisateur, pas seulement
										du vernis.
									</p>
								</div>
								<!-- end testimonial-slider__slide -->
							</div>
							<!-- end swiper-wrapper -->

							<div class="swiper-pagination"></div>
						</div>
						<!-- end swiper-container -->
					</div>
					<!-- end column -->
				</div>
				<!-- end row testimonials -->
			</section>
			<!-- end s-works -->

			<!-- ### contact
            ================================================== -->
			<section id="contact" class="s-contact target-section">
				<div class="row contact-top">
					<div class="column lg-12">
						<h2 class="text-pretitle">Contactez-moi</h2>

						<p class="h1">
							J’adorerais avoir de vos nouvelles. <br />
							Projet, question ou simple discussion tech - n’hésitez
							pas à m’écrire&nbsp;!
						</p>
					</div>
				</div>
				<!-- end contact-top -->

				<div class="row contact-bottom">
					<div
						class="column lg-4 md-6 tab-12 stack-on-550 contact-block"
					>
						<h3 class="text-pretitle">Me joindre à</h3>
						<p class="contact-links">
							<a
								href="mailto:omar.elbakri00@gmail.com"
